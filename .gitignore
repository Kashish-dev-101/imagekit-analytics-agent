# Customer data — never commit raw analytics exports
*.json

# Input folder — ignore customer data, keep scripts and README
input/*.json
input/*-extracted.txt

# Outputs folder — ignore all content, keep the folder itself
outputs/*
!outputs/.gitkeep

# Test folder — local only, not needed for agent to work
test/

# Version control folder — local only, not needed for agent to work
version-control/

# macOS
.DS_Store

# Editor
.vscode/
.idea/
