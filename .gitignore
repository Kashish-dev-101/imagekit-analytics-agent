# Customer data — never commit raw analytics exports
*.json

# Input folder — ignore customer data files, keep scripts and README
input/*-extracted.txt

# Outputs folder — ignore everything, no customer data should be committed
outputs/

# Test folder — keep README and video-prompt, ignore everything else
test/*
!test/README.md
!test/video-prompt.md

# Version control folder — keep README, ignore archived content
version-control/*
!version-control/README.md

# macOS
.DS_Store

# Editor
.vscode/
.idea/
